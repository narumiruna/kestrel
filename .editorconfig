root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview, PreviewScreenSizes
ktlint_standard_max-line-length = disabled
ktlint_standard_property-naming = disabled

[*.{xml,yml,yaml,toml}]
indent_style = space
indent_size = 2
