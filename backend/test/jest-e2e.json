{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "CommonJS",
          "moduleResolution": "Node",
          "resolvePackageJsonExports": false
        }
      }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!jose/)"]
}
